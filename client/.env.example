# Copy to .env.local for local overrides. On Vercel, set these under
# Project → Settings → Environment Variables (they are baked in at build time).

# Where the SyncWave server runs, e.g. your Render URL. Leave unset in local
# development: Vite proxies /api, /audio and /socket.io to localhost:3000.
VITE_BACKEND_URL=https://syncwave-server.onrender.com
