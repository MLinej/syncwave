# Vite only exposes env vars prefixed with VITE_ to client code.
# Leave VITE_BACKEND_URL unset to auto-detect (recommended): the client will
# use the same hostname you loaded the page from, on port 3000. This works
# whether you open the app via localhost or a LAN IP from a phone.
#
# Set it explicitly only if the server runs on a different host/port than
# the one serving this page.
# VITE_BACKEND_URL=http://10.10.10.164:3000
